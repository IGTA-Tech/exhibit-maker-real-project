# ===========================================
# Exhibit Maker - Environment Variables
# ===========================================

# Node Environment
NODE_ENV=development
PORT=3000

# ===========================================
# API2PDF Configuration (Required)
# ===========================================
API2PDF_API_KEY=your_api2pdf_key_here

# ===========================================
# Supabase Configuration (Required for persistence)
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

# ===========================================
# Google Drive Configuration (Optional)
# ===========================================
# Option 1: Path to credentials file (local development)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Option 2: Base64 encoded credentials (production/Railway)
# Generate with: base64 -i credentials.json
GOOGLE_CREDENTIALS_BASE64=

# Option 3: Base64 encoded OAuth token (if using OAuth flow)
# Generate with: base64 -i token.json
GOOGLE_TOKEN_BASE64=

# ===========================================
# Email Configuration (Optional)
# ===========================================
# Gmail with App Password
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password-here

# OR use other SMTP services:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASSWORD=your-sendgrid-api-key

# ===========================================
# AI Analysis Configuration (Optional)
# ===========================================
ANTHROPIC_API_KEY=your_claude_api_key_here
# OR
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# Email Configuration - SendGrid (Alternative)
# ===========================================
# SendGrid API Key (recommended for production)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# ===========================================
# Security & Rate Limiting
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-app.railway.app,http://localhost:3000

# Max requests per 15 minutes per IP
RATE_LIMIT_MAX=100

# Max URL-to-PDF conversions per hour per IP
CONVERSION_RATE_LIMIT=100
